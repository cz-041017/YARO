# --- 本地环境 / 构建产物（不发布） ---
.venv/
.venv-*/
venv/
build/
dist/
*.egg-info/
.eggs/
*.whl
*.zip

# --- 运行期数据（每台机器自己生成，含用户隐私与密钥） ---
.env
.yaro/
demo/
artifacts/
sessions/
runs/
data/raw/
secrets.json

# --- 缓存与日志 ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
chrome-launch-*.log
pip-uninstall-*

# --- pytest 临时目录（测试会在仓库根生成，里面有假的 secrets.json，绝不能上传） ---
pytest-of-*/
pytest-*/
.pytest_tmp/

# --- 开发文档（内部保留，不随仓库发布） ---
docs/ADR-*.md
.devnotes/
