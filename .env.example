# YARO 运行环境；复制为 .env 后填写。不要把 .env 提交到仓库。
# 更推荐：用 `yaro init` 生成，用 `yaro key set` 存 Key（不进 shell 历史、不进日志）。

# --- 模型 ---
# 推荐用 `yaro key set` 存到本地 0600 文件/系统钥匙串；这里留空即可。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash（有视觉，主力） / deepseek-v4-pro（无视觉，难题参谋）
YARO_MODEL=deepseek-flash
YARO_MODEL_PLAN=deepseek-v4-pro

# --- 隐私与出网（默认拒绝，必须显式授权）---
# off     完全不出网：只能用本地模型或演示模式（默认）
# text    允许请求打到模型服务，但图片全部剥离
# derived 额外允许 harness 渲染的诊断图（原图仍剥离）
# full    允许原始证据图
YARO_EGRESS=off
# 目标模型服务若是公网域名（如 api.deepseek.com），必须把它设为 1 才允许发送。
# 这是防止"配置漂移把客户图悄悄送到公网"的第二道闸。
YARO_EGRESS_ALLOW_PUBLIC=0

# 本地模型（不出网的推荐做法）：vLLM / Ollama / LM Studio 的 OpenAI 兼容端点
# DEEPSEEK_BASE_URL=http://127.0.0.1:8000/v1

# --- 路径 ---
# 会话/产物/运行的落盘位置（密钥文件 secrets.json 也在这里，权限 0600）
YARO_HOME=.yaro
# 工具能看到的根目录：默认为当前工作目录（在哪个项目里启动就操作哪个项目）
# GUI 的 demo 图也铺在这里的 demo/ 下，命令行跑时可直接用相对路径 demo/xx.png
YARO_WORKSPACE=

# --- 执行沙箱 ---
YARO_SANDBOX_IMAGE=python:3.12-slim
YARO_ALLOW_NET=0
YARO_ALLOW_UNSAFE_LOCAL=0
